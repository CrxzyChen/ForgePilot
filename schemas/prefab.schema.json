{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-kernel.dev/schema/prefab/2-0-0-alpha-1",
  "title": "AI Game Prefab",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "objects", "rootObjectIds"],
  "properties": {
    "schemaVersion": { "const": "2.0.0-alpha.1" },
    "id": { "$ref": "scene.schema.json#/$defs/semanticId" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "objects": {
      "type": "array",
      "items": { "$ref": "scene.schema.json#/$defs/object" }
    },
    "rootObjectIds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "scene.schema.json#/$defs/semanticId" },
      "uniqueItems": true
    },
    "basePrefab": { "type": "string" },
    "exposedProperties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "componentId", "property"],
        "properties": {
          "id": { "$ref": "scene.schema.json#/$defs/semanticId" },
          "componentId": { "$ref": "scene.schema.json#/$defs/semanticId" },
          "property": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
