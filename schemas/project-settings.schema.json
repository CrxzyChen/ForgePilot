{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-kernel.dev/schema/project-settings/2-0-0-alpha-1",
  "title": "AI Game versioned project settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "startupScene",
    "tickRate",
    "capabilities",
    "scriptRuntime",
    "buildTargets"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0-alpha.1" },
    "startupScene": { "type": ["string", "null"] },
    "tickRate": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "enabled"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "enabled": { "type": "boolean" },
          "settings": { "type": "object" }
        }
      }
    },
    "scriptRuntime": { "type": "string" },
    "buildTargets": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "project": { "type": "object" }
  }
}
