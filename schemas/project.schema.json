{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-kernel.dev/schema/project/1-0-0",
  "title": "AI Game Project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "engine",
    "entry",
    "templates",
    "targets",
    "defaultTarget",
    "capabilities",
    "paths"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[a-z0-9][a-z0-9_./-]*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "projectFormat"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "projectFormat": { "const": "1.0.0" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene"],
      "properties": {
        "scene": { "$ref": "#/$defs/projectPath" }
      }
    },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "defaultTarget": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assets", "scenes", "tests", "replays"],
      "properties": {
        "assets": { "$ref": "#/$defs/projectPath" },
        "scenes": { "$ref": "#/$defs/projectPath" },
        "tests": { "$ref": "#/$defs/projectPath" },
        "replays": { "$ref": "#/$defs/projectPath" }
      }
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
