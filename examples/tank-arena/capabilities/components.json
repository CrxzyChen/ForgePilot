{
  "schemaVersion": "2.0.0-alpha.1",
  "components": [
    {
      "type": "tank:unit",
      "label": "Tank Unit",
      "fields": [
        { "name": "team", "type": "string", "default": "neutral" },
        { "name": "health", "type": "number", "default": 1 }
      ]
    },
    {
      "type": "tank:weapon",
      "label": "Tank Weapon",
      "fields": [
        { "name": "nextFireTick", "type": "number", "default": 0 },
        { "name": "direction", "type": "vec2", "default": { "x": 0, "y": -1 } }
      ]
    },
    {
      "type": "tank:projectile",
      "label": "Projectile State",
      "fields": [
        { "name": "owner", "type": "string", "default": "" },
        { "name": "spent", "type": "boolean", "default": false }
      ]
    },
    {
      "type": "tank:enemy-state",
      "label": "Enemy State",
      "fields": [
        { "name": "breached", "type": "boolean", "default": false },
        { "name": "speed", "type": "number", "default": 1 }
      ]
    },
    {
      "type": "tank:game-state",
      "label": "Game State",
      "fields": [
        { "name": "phase", "type": "string", "default": "menu" },
        { "name": "score", "type": "number", "default": 0 },
        { "name": "enemiesRemaining", "type": "number", "default": 3 },
        { "name": "helpVisible", "type": "boolean", "default": false },
        { "name": "muted", "type": "boolean", "default": false },
        { "name": "masterVolume", "type": "number", "default": 0.8 }
      ]
    },
    {
      "type": "tank:input-latches",
      "label": "Input Latches",
      "fields": [
        { "name": "start-game", "type": "boolean", "default": false },
        { "name": "pause", "type": "boolean", "default": false },
        { "name": "restart", "type": "boolean", "default": false },
        { "name": "toggle-help", "type": "boolean", "default": false },
        { "name": "toggle-mute", "type": "boolean", "default": false },
        { "name": "volume-down", "type": "boolean", "default": false },
        { "name": "volume-up", "type": "boolean", "default": false }
      ]
    },
    {
      "type": "tank:wall",
      "label": "Tank Wall",
      "fields": [
        { "name": "destructible", "type": "boolean", "default": false },
        { "name": "health", "type": "number", "default": 0 }
      ]
    },
    {
      "type": "tank:lifetime",
      "label": "Deterministic Lifetime",
      "fields": [
        { "name": "destroyAtTick", "type": "number", "default": 0 },
        { "name": "durationTicks", "type": "number", "default": 8 }
      ]
    }
  ]
}
